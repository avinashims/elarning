# /opt/elearning/deploy/.env.production
# Shared DigitalOcean server (hotelbooking already on 9000, pgAdmin on 5050)

# E-learning API port (localhost only — Nginx proxies HTTPS)
APP_PORT=9001
PORT=9001

NODE_ENV=production

# Use EXISTING PostgreSQL on the server (same as hotelbooking/pgAdmin)
# host.docker.internal reaches the host from Docker on Linux
DATABASE_URL=postgresql://elearning:CHANGE_ME_elearning_db_password@host.docker.internal:5432/elearning?schema=public

# Redis (small container — only for e-learning)
REDIS_URL=redis://redis:6379

# JWT — use: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Your public URL (domain pointing to this droplet)
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Video
VIDEO_STORAGE_PATH=/app/videos
VIDEO_SIGNING_SECRET=CHANGE_ME_video_secret
VIDEO_URL_EXPIRY_SECONDS=900

# Android APK will use:
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api
