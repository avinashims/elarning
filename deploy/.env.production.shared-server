# /opt/elearning/deploy/.env.production
# Shared DigitalOcean server (hotelbooking already on 9000, pgAdmin on 5050)

# E-learning API port (also used by Android APK)
APP_PORT=9001
PORT=9001

# Web UI port (React site for teachers/students)
WEB_PORT=9002
VITE_API_URL=/api
# Web OAuth client ID (Google Cloud → Credentials → Web client). Baked into teacher/student web at build time.
VITE_GOOGLE_CLIENT_ID=

NODE_ENV=production

# Verify Google ID tokens from web + Android apps (comma-separated client IDs)
GOOGLE_CLIENT_IDS=

# PostgreSQL — use hotelbooking postgres container (recommended on shared server)
DATABASE_URL=postgresql://elearning:CHANGE_ME_elearning_db_password@hotelbooking-postgres-1:5432/elearning?schema=public
# Fallback if postgres is exposed on host:
# DATABASE_URL=postgresql://elearning:CHANGE_ME_elearning_db_password@host.docker.internal:5432/elearning?schema=public

# Redis (small container — only for e-learning)
REDIS_URL=redis://redis:6379

# JWT — use: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public web URL (use your droplet IP if no domain yet)
FRONTEND_URL=http://165.22.209.200:9002
CORS_ORIGINS=http://165.22.209.200:9002,http://165.22.209.200:9001

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Video
VIDEO_STORAGE_PATH=/app/videos
UPLOADS_PATH=/app/uploads
VIDEO_SIGNING_SECRET=CHANGE_ME_video_secret
VIDEO_URL_EXPIRY_SECONDS=900

# Android APK will use:
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api
