# Copy to /opt/elearning/.env on your DigitalOcean server
# Replace all CHANGE_ME values

# Database (matches docker-compose.prod.yml)
DB_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_URL=postgresql://elearning:CHANGE_ME_strong_db_password@postgres:5432/elearning?schema=public

# Redis (inside Docker network)
REDIS_URL=redis://redis:6379

# Server
PORT=5000
NODE_ENV=production

# JWT — generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=CHANGE_ME_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Your domain (after SSL setup)
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# Razorpay (optional)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Video
VIDEO_STORAGE_PATH=/app/videos
VIDEO_SIGNING_SECRET=CHANGE_ME_video_secret
VIDEO_URL_EXPIRY_SECONDS=900
