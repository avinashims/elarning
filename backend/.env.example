PORT=5000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elearning?schema=public"

REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET=your-access-token-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Legacy fallback (optional)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

FRONTEND_URL=http://localhost:5173
# Comma-separated list for production (web + mobile web)
# CORS_ORIGINS=https://your-app.vercel.app,https://www.yourdomain.com

VIDEO_STORAGE_PATH=../videos
VIDEO_SIGNING_SECRET=your-video-signing-secret
VIDEO_URL_EXPIRY_SECONDS=900
